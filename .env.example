# Copy to .env and fill in all three values from https://console.shelby.xyz
# .env is gitignored. Never commit a real key.

# Your access key ID. Starts with SHLB.
SHELBY_ACCESS_KEY_ID=

# Your secret access key: the value the console calls your API key.
SHELBY_SECRET_ACCESS_KEY=

# Your bucket name, for example shelby-managed-account-1. It already exists.
SHELBY_BUCKET=

# Optional. Defaults to the hosted endpoint.
# SHELBY_S3_ENDPOINT=https://s3.beta.shelby.xyz
