# Shelby Quickstart — Environment Variables
# Generated by `npm run config` from your ~/.shelby/config.yaml
# Copy this file to .env and fill in your values, or use `npm run config`

# Account — The Aptos account used for Shelby operations
SHELBY_ACCOUNT_NAME=
SHELBY_ACCOUNT_ADDRESS=
SHELBY_ACCOUNT_PRIVATE_KEY=

# Context — The Shelby CLI context to use
SHELBY_CONTEXT_NAME=

# API Key — Obtain your own at https://docs.shelby.xyz/sdks/typescript/acquire-api-keys
SHELBY_API_KEY=

# Network — Aptos network configuration
SHELBY_NETWORK_NAME=
SHELBY_FULLNODE=
SHELBY_FAUCET=
SHELBY_INDEXER=
SHELBY_PEPPER=
SHELBY_PROVER=
